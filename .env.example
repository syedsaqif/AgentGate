# Copy to .env for local development. Never commit .env.
AGENTGATE_PROFILE=test
AGENTGATE_GATEWAY_ORIGIN=http://127.0.0.1:8000
AGENTGATE_BANK_ORIGIN=http://127.0.0.1:8001
AGENTGATE_GATEWAY_DB=runtime/gateway.db
AGENTGATE_BANK_DB=runtime/bank.db

# Generate local values; do not reuse these placeholder strings.
AGENTGATE_BANK_SERVICE_CREDENTIAL=replace-with-local-random-value
AGENTGATE_HUMAN_SESSION_SECRET=replace-with-local-random-value
AGENTGATE_DEV_CONTROL_CREDENTIAL=replace-with-local-random-value

# Private signing keys are file paths outside source control.
AGENTGATE_MANDATE_SIGNING_KEY_PATH=
AGENTGATE_AUDIT_SIGNING_KEY_PATH=
AGENTGATE_TOKEN_SIGNING_KEY_PATH=
