events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;

    server {
        listen ${PORT};

        # 1. Frontend Single Page Application
        location / {
            root /app/frontend/dist;
            try_files $uri $uri/ /index.html;
        }

        # 2. Demo Server (Presenter Stage, BillPal AI Agent, Demo Bank, Scenarios)
        location /demo/ {
            proxy_pass http://127.0.0.1:8002/demo/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
        }

        # 3. Gateway Health & System Endpoints
        location /health/ {
            proxy_pass http://127.0.0.1:8000/health/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # 4. Gateway SSE Events Stream
        location /events/ {
            proxy_pass http://127.0.0.1:8000/events/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_buffering off;
        }

        # 5. Gateway Core Governance Routes
        location /mandates/ {
            proxy_pass http://127.0.0.1:8000/mandates/;
            proxy_set_header Host $host;
        }

        location /escalation/ {
            proxy_pass http://127.0.0.1:8000/escalation/;
            proxy_set_header Host $host;
        }

        location /audit/ {
            proxy_pass http://127.0.0.1:8000/audit/;
            proxy_set_header Host $host;
        }

        location /actions/ {
            proxy_pass http://127.0.0.1:8000/actions/;
            proxy_set_header Host $host;
        }

        location /identity/ {
            proxy_pass http://127.0.0.1:8000/identity/;
            proxy_set_header Host $host;
        }
    }
}
